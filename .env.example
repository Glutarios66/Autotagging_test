PDFR_ENVIRONMENT=development
PDFR_DATABASE_URL=sqlite:///./pdf_remediation.db
PDFR_ARTIFACT_BACKEND=filesystem
PDFR_ARTIFACT_ROOT=./artifacts
PDFR_S3_BUCKET=pdf-remediation
PDFR_S3_ENDPOINT_URL=http://localhost:9000
PDFR_S3_ACCESS_KEY=minioadmin
PDFR_S3_SECRET_KEY=minioadmin
PDFR_S3_REGION=us-east-1
PDFR_RECIPE_DIR=./config/pipelines
PDFR_CELERY_BROKER_URL=redis://localhost:6379/0
PDFR_CELERY_RESULT_BACKEND=redis://localhost:6379/1
PDFR_CELERY_QUEUE=pdf-remediation
PDFR_RUN_JOBS_INLINE=true
PDFR_MAX_UPLOAD_BYTES=26214400
PDFR_LOG_LEVEL=INFO
PDFR_JSON_LOGS=true
